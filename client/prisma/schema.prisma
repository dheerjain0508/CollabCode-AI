generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id @default(cuid())
  name     String?
  email    String    @unique
  projects Project[]
}

model Project {
  id        String   @id @default(cuid())
  title     String
  status    String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  @@index([ownerId])
}